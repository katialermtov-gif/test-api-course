                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var schema = {",
                                    "  type: \"object\",",
                                    "  required: [\"id\", \"name\", \"deleted\", \"folder\", \"space\", \"statuses\"],",
                                    "  properties: {",
                                    "    id: { type: \"string\" },",
                                    "    name: { type: \"string\" },",
                                    "    deleted: { type: \"boolean\" },",
                                    "    orderindex: { type: \"number\" },",
                                    "    content: { type: \"string\" },",
                                    "    priority: { type: \"null\" },",
                                    "    assignee: { type: \"null\" },",
                                    "    task_count: { type: \"number\" },",
                                    "    due_date: { type: \"null\" },",
                                    "    start_date: { type: \"null\" },",
                                    "    archived: { type: \"boolean\" },",
                                    "    override_statuses: { type: \"boolean\" },",
                                    "    permission_level: { type: \"string\" },",
                                    "",
                                    "    folder: {",
                                    "      type: \"object\",",
                                    "      required: [\"id\", \"name\", \"hidden\", \"archived\", \"access\"],",
                                    "      properties: {",
                                    "        id: { type: \"string\" },",
                                    "        name: { type: \"string\" },",
                                    "        hidden: { type: \"boolean\" },",
                                    "        archived: { type: \"boolean\" },",
                                    "        access: { type: \"boolean\" }",
                                    "      }",
                                    "    },",
                                    "",
                                    "    space: {",
                                    "      type: \"object\",",
                                    "      required: [\"id\", \"name\", \"archived\", \"access\"],",
                                    "      properties: {",
                                    "        id: { type: \"string\" },",
                                    "        name: { type: \"string\" },",
                                    "        archived: { type: \"boolean\" },",
                                    "        access: { type: \"boolean\" }",
                                    "      }",
                                    "    },",
                                    "",
                                    "    statuses: {",
                                    "      type: \"array\",",
                                    "      items: {",
                                    "        type: \"object\",",
                                    "        required: [\"id\", \"status\", \"orderindex\", \"color\", \"type\", \"status_group\"],",
                                    "        properties: {",
                                    "          id: { type: \"string\" },",
                                    "          status: { type: \"string\" },",
                                    "          orderindex: { type: \"number\" },",
                                    "          color: { type: \"string\" },",
                                    "          type: { type: \"string\" },",
                                    "          status_group: { type: \"string\" }",
                                    "        }",
                                    "      }",
                                    "    }",
                                    "  }",
                                    "};",
                                    "",
                                    "",
                                    "pm.test('Schema is valid', function() {",
                                    "    var jsonData = pm.response.json();",
                                    "    console.log(jsonData)",
                                    "  pm.expect(tv4.validate(jsonData, schema)).to.be.true;",
                                    " ",
                                    "});",
                                    ""
                                ],
                                "type": "text/javascript",
                                "packages": {}
                            }
